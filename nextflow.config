params.outdir = "results"
params.dorado = "/home/edgealienlin/tools/dorado-2.1.2-linux-x64/bin/dorado"

process {
    executor = 'local'
    // one basecall at a time: a single laptop GPU has no room to share
    withName: BASECALL { maxForks = 1 }
}

env {
    MLFLOW_TRACKING_URI = "sqlite:///${projectDir}/mlruns.db"
}

profiles {
    local { process.executor = 'local' }
}

report   { enabled = true; file = "${params.outdir}/_reports/report.html";   overwrite = true }
timeline { enabled = true; file = "${params.outdir}/_reports/timeline.html"; overwrite = true }
trace    { enabled = true; file = "${params.outdir}/_reports/trace.txt";     overwrite = true }
